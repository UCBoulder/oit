}

/**
 * Rename taxonomy terms for service dashboard categories.
 */
function oit_update_10017() {
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  // Update UCB Guest Wireless (tid: 1285) to 'CU Guest'.
  $term = $term_storage->load(1285);
  if ($term) {
    $term->setName('CU Guest');
    $term->save();
  }

  // Update UCB Wireless (tid: 1286) to 'CU Secure'.
  $term = $term_storage->load(1286);
  if ($term) {
    $term->setName('CU Secure');
    $term->save();
  }

  // Delete Duplicate CU Secure term.
  $term = $term_storage->load(1300);
  if ($term) {
    $term->delete();
  }

  // Delete Duplicate CU Guest term.
  $term = $term_storage->load(1301);
  if ($term) {
    $term->delete();
  }
}

/**
