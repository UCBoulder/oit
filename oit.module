      ];
      $form['field_dl_facstaff']['#group'] = 'protected_downloads';
      $form['field_dl_student']['#group'] = 'protected_downloads';
      $form['field_dl_authenticated']['#group'] = 'protected_downloads';
      // Group for service type.
      $form['type_service'] = [
        '#title' => t('Service'),
        '#type' => 'details',
        '#group' => 'advanced',
        '#open' => 0,
        '#weight' => 102,
