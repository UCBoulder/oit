      $form['taxonomy_vocabulary_11']['#group'] = 'type_service';
      $form['field_service_main_page']['#group'] = 'type_service';
      $form['field_services_related']['#group'] = 'type_service';
      $form['field_tut_comp_type_d7']['#group'] = 'type_service';
